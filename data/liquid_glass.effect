// Liquid Glass filter for OBS
// Apple "Liquid Glass" style panel: the panel's rounded-rect SDF is treated
// as a lens height-field. Its gradient gives a proper per-pixel surface
// normal (not just "away from center"), which drives backdrop refraction,
// chromatic aberration and a Blinn-Phong glossy sheen. A thin bright rim,
// a slow animated diagonal glint, frosted grain and a soft drop shadow
// round out the material look.

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_size;             // source size in pixels
uniform float4 panels[8];           // xy = panel top-left (pixels), zw = panel width/height (pixels)
uniform int panel_count;            // how many entries in `panels` are valid (0..8)
uniform float corner_radius;        // pixels, shared by every panel

uniform float blur_amount;          // pixel radius of backdrop blur
uniform float refraction_strength;  // pixel offset at the panel edge
uniform float chromatic_aberration; // pixel offset for R/B channel split
uniform float lens_magnification;   // 0..1ish, radial bulge/compression strength at the rim

uniform float shimmer_speed;        // radians/sec
uniform float shimmer_amplitude;    // pixels
uniform float elapsed_time;         // seconds, free running

uniform float specular_intensity;   // glossy Blinn-Phong sheen strength
uniform float specular_shininess;   // sheen tightness (higher = smaller hotspot)

uniform float edge_highlight_width;     // pixels, thin bright rim
uniform float edge_highlight_intensity; // 0..2ish

uniform float sheen_speed;     // sweeps/sec of the animated glint
uniform float sheen_width;     // 0..1, width of the glint band
uniform float sheen_intensity; // 0..1ish

uniform float content_reactivity;  // 0..1, how much backdrop content steers light/glint
uniform float adaptive_brightness; // 0..1, lift over dark backdrops / contrast over bright ones
uniform float vibrancy;             // 0..1ish, saturation boost of the refracted backdrop

uniform float shadow_intensity; // 0..1, drop shadow strength
uniform float shadow_size;      // pixels, drop shadow falloff distance

uniform float noise_amount; // 0..~0.1, frosted grain

uniform float border_width; // pixels
uniform float4 border_color; // rgba
uniform float4 tint_color;   // rgba

sampler_state def_sampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

// Signed distance to a rounded box centered at the origin.
// b = half size, r = corner radius. Negative inside, positive outside.
float sdRoundedBox(float2 p, float2 b, float r)
{
	float2 q = abs(p) - b + r;
	return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;
}

float hash(float2 p)
{
	return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

float4 PSGlass(VertData v_in) : TARGET
{
	float4 orig = image.Sample(def_sampler, v_in.uv);

	float2 pixel = v_in.uv * uv_size;

	// Union of every active panel's rounded-box SDF: find the nearest one and
	// keep its geometry (local/half_size/r) for everything downstream. With
	// panel_count == 0, d stays at its huge sentinel value and the early-out
	// below returns the untouched backdrop, so "no panels" just means "no blur".
	float2 half_size = float2(1.0, 1.0);
	float2 center    = float2(0.0, 0.0);
	float2 local     = pixel;
	float r = 0.0;
	float d = 1e9;

	for (int i = 0; i < 8; i++) {
		if (i >= panel_count)
			continue;

		// Indexing the uniform array and swizzling in the same expression
		// (panels[i].zw) trips up libobs's effect-to-GLSL translator --
		// go through a plain local first.
		float4 p    = panels[i];
		float2 p_hs = max(p.zw * 0.5, float2(1.0, 1.0));
		float2 p_c  = p.xy + p_hs;
		float2 p_l  = pixel - p_c;
		float p_r   = min(corner_radius, min(p_hs.x, p_hs.y));
		float p_d   = sdRoundedBox(p_l, p_hs, p_r);

		if (p_d < d) {
			d = p_d;
			local = p_l;
			half_size = p_hs;
			center = p_c;
			r = p_r;
		}
	}

	float shadow_max = max(shadow_size, 0.001);
	if (d > shadow_max + 2.0)
		return orig;

	// Soft drop shadow: 1 right at the panel edge, fading out to shadow_size.
	float shadow_mask = (1.0 - smoothstep(0.0, shadow_max, d)) * saturate(shadow_intensity);

	if (d > 1.5) {
		float4 shadowed = lerp(orig, float4(0.0, 0.0, 0.0, orig.a), shadow_mask);
		return shadowed;
	}

	// True surface normal of the rounded-rect "lens", from the SDF gradient.
	// This bends light correctly along flat edges too, not just corners.
	float dx = sdRoundedBox(local + float2(1.0, 0.0), half_size, r) -
		   sdRoundedBox(local - float2(1.0, 0.0), half_size, r);
	float dy = sdRoundedBox(local + float2(0.0, 1.0), half_size, r) -
		   sdRoundedBox(local - float2(0.0, 1.0), half_size, r);
	float2 grad = normalize(float2(dx, dy) + float2(1e-5, 1e-5));

	// t: 0 at the rim, 1 deep in the flat interior. Real glass bends light
	// only in a rim-sized band and stays flat in the middle.
	float t = saturate(-d / max(r, 1.0));
	float domeFalloff = pow(1.0 - t, 1.4);

	float2 shimmer = float2(sin(elapsed_time * shimmer_speed + local.y * 0.05),
				 cos(elapsed_time * shimmer_speed + local.x * 0.05)) *
			 shimmer_amplitude;

	float2 refract_px = grad * domeFalloff * refraction_strength + shimmer;
	float2 sample_uv  = v_in.uv + refract_px / uv_size;

	// Lens magnification: near the rim, pull the sample radially toward the
	// panel center and compress it, the way a real plano-convex lens bends
	// its image inward at the boundary. This is what makes backdrop content
	// visibly bulge/compress as it crosses under the glass, instead of just
	// shifting by a constant offset -- the single biggest cue that reads as
	// "real refracting lens" rather than "blurred, slightly shifted panel".
	float2 center_uv = center / uv_size;
	float bulge = domeFalloff * saturate(lens_magnification);
	sample_uv = lerp(sample_uv, center_uv + (sample_uv - center_uv) * (1.0 - bulge), bulge * 0.85);

	// Backdrop blur: gaussian-weighted 5x5 taps around the refracted sample.
	float4 color = float4(0.0, 0.0, 0.0, 0.0);
	float wsum = 0.0;
	for (int x = -2; x <= 2; x++) {
		for (int y = -2; y <= 2; y++) {
			float2 offs = float2(float(x), float(y)) * (blur_amount * 0.5) / uv_size;
			float w = exp(-float(x * x + y * y) * 0.22);
			color += image.Sample(def_sampler, sample_uv + offs) * w;
			wsum += w;
		}
	}
	color /= max(wsum, 0.0001);

	// Chromatic aberration along the same lens direction.
	float2 ca_px = grad * domeFalloff * chromatic_aberration;
	color.r = image.Sample(def_sampler, sample_uv + ca_px / uv_size).r;
	color.b = image.Sample(def_sampler, sample_uv - ca_px / uv_size).b;

	// Probe the *actual* backdrop under the panel: its local brightness and
	// the direction it gets brighter in. This is what makes the glass feel
	// like it's really looking through to the scene instead of playing a
	// canned animation over whatever happens to be behind it.
	float3 luma_w = float3(0.299, 0.587, 0.114);
	float2 probe = float2(14.0, 14.0) / uv_size;
	float lumaC = dot(color.rgb, luma_w);
	float lumaR = dot(image.Sample(def_sampler, sample_uv + float2(probe.x, 0.0)).rgb, luma_w);
	float lumaL = dot(image.Sample(def_sampler, sample_uv - float2(probe.x, 0.0)).rgb, luma_w);
	float lumaD = dot(image.Sample(def_sampler, sample_uv + float2(0.0, probe.y)).rgb, luma_w);
	float lumaU = dot(image.Sample(def_sampler, sample_uv - float2(0.0, probe.y)).rgb, luma_w);
	float2 lumaGrad = float2(lumaR - lumaL, lumaD - lumaU);
	float lumaGradMag = length(lumaGrad);

	color.rgb = lerp(color.rgb, tint_color.rgb, tint_color.a);

	// Blinn-Phong glossy sheen from a pseudo-3D normal: flat (facing the
	// viewer) in the interior, tilting toward the rim. The light direction
	// itself leans toward real bright spots in the backdrop (weighted by
	// content_reactivity), so the sheen tracks whatever is actually behind
	// the glass rather than a fixed studio light.
	float2 n2 = grad * (1.0 - t);
	float nz  = sqrt(saturate(1.0 - dot(n2, n2)));
	float3 N  = normalize(float3(n2, nz));
	float3 L0 = normalize(float3(-0.45, -0.7, 0.55));
	// Smoothstepped and capped so a hard rectangular edge in the backdrop
	// (a window, webcam frame, UI panel) can only nudge the light gently,
	// never yank it hard enough to stamp that edge's shape onto the glass.
	float contentPull = smoothstep(0.0, 0.35, lumaGradMag) * saturate(content_reactivity) * 0.55;
	float2 L_xy = lerp(L0.xy, normalize(lumaGrad + 1e-5) * length(L0.xy), contentPull);
	float3 L  = normalize(float3(L_xy, L0.z));
	float3 V  = float3(0.0, 0.0, 1.0);
	float3 H  = normalize(L + V);
	float spec = pow(saturate(dot(N, H)), max(specular_shininess, 1.0)) * specular_intensity;
	color.rgb += spec;

	// Thin bright rim right at the boundary.
	float rim = 1.0 - smoothstep(0.0, max(edge_highlight_width, 0.001), abs(d));
	float light_bias = saturate(dot(grad, -L.xy) * 0.5 + 0.5);
	color.rgb += rim * (0.3 + 0.7 * light_bias) * edge_highlight_intensity;

	// Diagonal glint sweep. A sine oscillation (not a frac()-wrapped ramp)
	// so the sweep glides back and forth with no seam -- a sawtooth resets
	// hard every cycle, which is exactly the "stutter" a looping decal reads
	// as; a sine has no discontinuity anywhere and eases naturally at the
	// turnaround instead of snapping back.
	float diag = (local.x + local.y) / max(half_size.x + half_size.y, 1.0);
	float sweepPos = sin(elapsed_time * sheen_speed * 3.14159265) * 1.2;
	float sheenTime = exp(-pow((diag - sweepPos) / max(sheen_width, 0.001), 2.0));
	// Real backdrop detail adds a modest bonus sparkle on top, but the base
	// sweep (which fully traces the panel's own rounded shape) always shows
	// at full strength -- content can never gate it down to a hole, so a
	// hard-edged window/webcam behind the glass can't stamp its silhouette
	// onto the glint.
	float contentBoost = smoothstep(0.0, 0.4, lumaGradMag) * saturate(content_reactivity) * 0.6;
	float sheen = sheenTime * sheen_intensity * (1.0 + contentBoost);
	color.rgb += sheen;

	// Adaptive brightness: lift the glass over dark backdrops so detail
	// doesn't disappear into it, and pull it down slightly over bright
	// backdrops for contrast/legibility -- real glass looks different over
	// a bright sky than over a dark room, this shouldn't look identical either.
	float adapt = smoothstep(0.15, 0.75, lumaC);
	color.rgb += (1.0 - adapt) * adaptive_brightness * 0.10;
	color.rgb -= adapt * adaptive_brightness * 0.12;

	// Vibrancy: a light saturation boost on the refracted backdrop so colors
	// popping through the glass feel punchier than a flat blur, like real
	// curved glass concentrating light.
	float outLuma = dot(color.rgb, luma_w);
	color.rgb = lerp(float3(outLuma, outLuma, outLuma), color.rgb, 1.0 + saturate(vibrancy));

	// Frosted grain, stable per-pixel (not time-varying) so it reads as a
	// material texture rather than sensor noise.
	color.rgb += (hash(pixel) - 0.5) * noise_amount;

	// Border stroke.
	float border_mask = 1.0 - smoothstep(0.0, max(border_width, 0.001), abs(d));
	color.rgb = lerp(color.rgb, border_color.rgb, border_mask * border_color.a);

	color.a = orig.a;

	float panel_mix = 1.0 - smoothstep(-1.5, 1.5, d);
	float4 shadowed = lerp(orig, float4(0.0, 0.0, 0.0, orig.a), shadow_mask * (1.0 - panel_mix));
	return lerp(shadowed, color, panel_mix);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGlass(v_in);
	}
}
